# Copy this file to .env and replace both placeholder values before starting Docker Compose.
POSTGRES_DB=incidentops
POSTGRES_USER=incidentops
POSTGRES_PASSWORD=replace-with-a-local-development-password

# JwtConfig expects a Base64-encoded secret with at least 256 bits after decoding.
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret

# Optional: creates one ADMIN only when the users table is empty.
# Remove these values after the first administrator has been created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
