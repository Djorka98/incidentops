# Local Docker Compose configuration. Copy this file to .env and replace the
# placeholders locally. Never commit the resulting .env file.

POSTGRES_DB=incidentops
POSTGRES_USER=incidentops
POSTGRES_PASSWORD=<local-database-password>

# Used when running the JAR directly. Docker Compose supplies its own internal
# JDBC URL and explicitly starts the backend with the dev profile.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/incidentops
SPRING_DATASOURCE_USERNAME=incidentops
SPRING_DATASOURCE_PASSWORD=<local-database-password>
PORT=8080

# Base64-encoded secret containing at least 256 bits after decoding.
JWT_SECRET=<base64-encoded-256-bit-secret>

# Exact browser origins, comma-separated. Never use * in production.
FRONTEND_URLS=http://localhost:5173,https://frontend-production.example
# Legacy single-origin fallback; leave empty when FRONTEND_URLS is present.
FRONTEND_URL=

PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# Optional locally; required to deliver transactional email.
RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=no-reply@verified-domain.example
RESEND_FROM_NAME=IncidentOps
CRON_SECRET=<strong-random-secret>

# Temporary and optional: use both only when bootstrapping an empty database.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Keep false for a new or already-managed Flyway database.
FLYWAY_BASELINE_ON_MIGRATE=false
